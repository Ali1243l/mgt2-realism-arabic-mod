#!/bin/sh
# team rule (CLAUDE.md): never push to main; merge pull requests on GitHub instead
while read local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "Blocked: no pushes to main. Push your feature/fix branch and open a pull request." >&2
    exit 1
  fi
done
